# Pullbox production Docker Compose environment
#
# Copy this file next to your compose file as .env and replace the paths with
# real host or NAS paths before starting Pullbox. If you already keep a shared
# Docker Compose .env file, copy the variables from this file into that existing
# file instead of creating a separate Pullbox-only .env.
#
# Pullbox's production image already runs as UID/GID 65532:65532. Do not add
# PUID/PGID variables or a compose user: override unless you are intentionally
# departing from the hardened-image contract.
#
# On Linux hosts, create a local group with GID 65532 and add your user before
# first startup if you want to browse Pullbox-created files from the host:
#
#   if ! getent group 65532 >/dev/null; then
#     sudo groupadd --gid 65532 pullbox-runtime
#   fi
#   sudo usermod -aG "$(getent group 65532 | cut -d: -f1)" "$USER"
#
# Log out and back in after usermod.

TZ=America/New_York
PULLBOX_IMAGE=ghcr.io/pullboxapp/pullbox:latest
PULLBOX_HOST_PORT=8585
PULLBOX_READER_ENABLED=true

# Host paths mounted into the container. These are used by Docker Compose for
# volume mapping and are not Pullbox application settings.
# /data contains Pullbox state: database, config.xml, logs, backups, and temp
# files. Put this on durable local storage and include it in backups.
PULLBOX_DATA_PATH=/path/to/pullbox-appdata

# /comics and /downloads must be writable by UID/GID 65532 for normal use.
# /imports must be writable by UID/GID 65532 when imports move, rewrite, or
# clean up source files. Use /imports/remote-drop inside Pullbox for manual
# folder-import staging.
COMICS_PATH=/path/to/comics
DOWNLOADS_PATH=/path/to/shared-downloads
IMPORTS_PATH=/path/to/imports
IMPORTS_DROP_PATH=/path/to/imports/remote-drop

# Reference values for host permission commands. These are not consumed by
# Pullbox directly.
PULLBOX_RUNTIME_UID=65532
PULLBOX_RUNTIME_GID=65532

# ---------------------------------------------------------------------------
# Optional Pullbox runtime environment variables
# ---------------------------------------------------------------------------
# Leave these commented unless you intentionally want the container environment
# to manage the value. Runtime-managed values can override UI/database settings
# and may appear read-only or environment-managed inside Pullbox.
#
# If you add one of these to an existing Docker Compose .env file, make sure
# your compose service also passes it under environment, for example:
#
#   environment:
#     PULLBOX_BASE_URL: ${PULLBOX_BASE_URL}
#
# The default docker/docker-compose.yml keeps only the minimum required values
# active so first-run setup remains simple.

# Runtime identity and URLs
# PULLBOX_INSTANCE_NAME=Pullbox
# PULLBOX_BASE_URL=http://localhost:8585
# PULLBOX_BIND_ADDRESS=0.0.0.0
# PULLBOX_PORT=8585

# Database and app state
# PULLBOX_DB_URL=sqlite+aiosqlite:////data/pullbox.db
# PULLBOX_SQLITE_JOURNAL_MODE=WAL
# PULLBOX_DATA_DIR=/data
# PULLBOX_LIBRARY_ROOT=/comics
# PULLBOX_COVERS_DIR=/comics/.covers
# PULLBOX_LOGS_DIR=/data/logs
# PULLBOX_TEMP_DIR=/data/tmp
# PULLBOX_BACKUP_DIR=/data/backups

# Security
# Normal Docker installs should leave PULLBOX_SECRET_KEY unset so /data/config.xml
# owns the application secret. If you set it, keep it stable forever.
# PULLBOX_SECRET_KEY=
# PULLBOX_SESSION_LIFETIME_HOURS=24
# PULLBOX_TRUSTED_PROXIES=
# PULLBOX_LOCAL_ADDRESSES=

# Native HTTPS
# PULLBOX_HTTPS_ENABLED=false
# PULLBOX_HTTPS_CERT_PATH=/config/certs/pullbox.crt
# PULLBOX_HTTPS_KEY_PATH=/config/certs/pullbox.key
# PULLBOX_HTTPS_CERT_ROOT=/config/certs

# Logging and diagnostics
# PULLBOX_LOG_LEVEL=INFO
# PULLBOX_LOG_SIZE_LIMIT_MB=1
# PULLBOX_LOG_BACKUP_COUNT=5
# PULLBOX_DEBUG=false
# PULLBOX_STARTUP_UPDATE_CHECK_ENABLED=true

# Manual empty Story Arc creation (provider/import creation is unaffected)
# PULLBOX_STORY_ARC_MANUAL_CREATE_ENABLED=false

# Embedded comic reader
# Set false for an immediate rollback that hides Read and disables reader APIs
# without deleting source comics or private resume state.
# PULLBOX_READER_ENABLED=true
# PULLBOX_READER_CACHE_MAX_MB=512
# PULLBOX_READER_WORKER_COUNT=2
# PULLBOX_READER_WORKER_WAIT_SECONDS=2.0

# Rate limits
# PULLBOX_RATE_LIMIT_ENABLED=true
# PULLBOX_RATE_LIMIT_TIER1=60
# PULLBOX_RATE_LIMIT_TIER2=120
# PULLBOX_RATE_LIMIT_TIER3=300

# Metadata providers
# PULLBOX_COMICVINE_API_KEY=
# PULLBOX_COMICVINE_RATE_LIMIT=200
# PULLBOX_DATA_API_BASE_URL=https://api.pullbox.app
# PULLBOX_METADATA_REFRESH_DAYS=30

# Scheduler cadence
# PULLBOX_SEARCH_INTERVAL_HOURS=6
# PULLBOX_SCAN_INTERVAL_HOURS=24
# PULLBOX_DOWNLOAD_POLL_SECONDS=3
# PULLBOX_PROCESS_COMPLETED_INTERVAL_SECONDS=300
# PULLBOX_BACKUP_INTERVAL_DAYS=7
# PULLBOX_BACKUP_RETENTION_DAYS=28
# PULLBOX_HISTORY_RETENTION_DAYS=90

# Health checks
# PULLBOX_HEALTH_CHECK_INTERVAL_MINUTES=5
# PULLBOX_HEALTH_SCHEDULER_INTERVAL_MINUTES=30
# PULLBOX_HEALTH_DATABASE_INTERVAL_MINUTES=15
# PULLBOX_HEALTH_FILESYSTEM_INTERVAL_MINUTES=15
# PULLBOX_HEALTH_SYSTEM_INTERVAL_MINUTES=15
# PULLBOX_HEALTH_DOWNLOAD_CLIENTS_INTERVAL_HOURS=4
# PULLBOX_HEALTH_INDEXERS_INTERVAL_HOURS=8
# PULLBOX_HEALTH_COMICVINE_INTERVAL_HOURS=8
# PULLBOX_HEALTH_HISTORY_RETENTION_DAYS=1

# Library naming defaults. The in-app Media Management settings are preferred
# after setup; use env only when you want bootstrap-managed defaults.
# PULLBOX_NAMING_SERIES_FORMAT="{series} ({year})"
# PULLBOX_NAMING_ISSUE_FORMAT="{series} ({year}) #{issue:03d}"

# Import concurrency. Scan 0 = auto (up to 4 inspectors, capped by visible
# CPU/container and available-memory limits). Use 1 for slow/shared disks or
# explicitly test 2-16; an explicit value never exceeds the resource ceiling.
# Inspection never changes file-safety policy. Step 4 workers remain separately
# budgeted because conversions can require substantial temporary disk space.
# PULLBOX_IMPORT_SCAN_WORKER_COUNT=0
# PULLBOX_IMPORT_FILE_WORKER_COUNT=2

# Import debug controls. These should stay disabled for normal production use.
# PULLBOX_IMPORT_DEBUG_SLOW_MODE=false
# PULLBOX_IMPORT_DEBUG_PHASE_DELAY_SECONDS=1.25
# PULLBOX_IMPORT_DEBUG_ITEM_DELAY_SECONDS=0.4
